(version 1)
# v31.0 rules calibrated to JLCDFM: track/via spacing 0.2, track-to-pad 0.18, via ring 0.2 (0.7/0.3 via)
(rule "via and track clearance 0.2"
  (constraint clearance (min 0.2mm))
  (condition "(A.Type == 'Via' || A.Type == 'Track') && (B.Type == 'Via' || B.Type == 'Track')"))
(rule "track to pad 0.18"
  (constraint clearance (min 0.18mm))
  (condition "(A.Type == 'Via' || A.Type == 'Track') && B.Type == 'Pad'"))
(rule "copper to edge 0.3 (JLC 0.3 recommended)"
  (constraint edge_clearance (min 0.3mm)))
