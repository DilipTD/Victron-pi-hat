  (rectangle (start 396.24 237.49) (end 548.64 323.85) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid "99898067-d503-4d8a-8a80-50ba9c9f8ee9"))
  (text "POWER INPUT (1xx)  -  7-40 V input, 7 A fuse, input capacitors" (at 22.86 30.48 0) (effects (font (size 2.5 2.5) bold) (justify left bottom)) (uuid "ced904d5-714e-4d35-a233-9bcab6b9aca5"))
  (text "F101 is a 7 A fuse in the + input. C101-C104 smooth the input. No reverse-polarity FET or TVS on the board: protect the input outside." (at 22.86 73.66 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "0c5285fd-a67b-4629-a9f4-4ea02af7b85c"))
  (text "5 V REGULATOR (2xx)  -  U201 buck module 5 V / 5 A" (at 195.58 30.48 0) (effects (font (size 2.5 2.5) bold) (justify left bottom)) (uuid "a0b88b61-f71a-44e0-868e-73e790fed5f5"))
  (text "U201: 7-40 V in from VIN_P, 5.0 V out. F101 = 7 A input fuse. No branch fuses: the U201 current limit protects the 5 V side." (at 195.58 73.66 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "42edea7c-e5e6-49d1-9b18-cf5ba6a6cfe3"))
  (text "RASPBERRY PI 40-PIN HEADER (J201)" (at 360.68 30.48 0) (effects (font (size 2.5 2.5) bold) (justify left bottom)) (uuid "b7377b0b-cbe5-4864-ab2d-f54585280354"))
  (text "3V3 comes from the Pi (pins 1/17). HAT +5V feeds the Pi (pins 2/4)." (at 360.68 104.14 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "94a12c61-da45-490c-9f46-fffff3031de6"))
  (text "HAT ID EEPROM (8xx)" (at 469.9 30.48 0) (effects (font (size 2.5 2.5) bold) (justify left bottom)) (uuid "aa71c9d2-12a5-4f32-a3cf-f0c08cd8679a"))
  (text "Bridge JP801 to GND only while writing the EEPROM." (at 469.9 104.14 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "cab7797a-6200-4748-b78e-2eedb3f36f0a"))
  (text "VE.DIRECT 1 + 2 (3xx)  -  I2C dual UART SC16IS752, 470R series resistors" (at 22.86 120.65 0) (effects (font (size 2 2) bold) (justify left bottom)) (uuid "6d68bd9f-e363-4609-9850-4b2b01891c62"))
  (text "VE.Direct is 3.3 V / 5 V TTL. 470R limits current into the Victron port. Address: A0=A1=3V3. 14.7456 MHz crystal, 15 pF load caps." (at 22.86 227.33 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "129ebf67-6c75-4c3a-85cc-7b1b855020a8"))
  (text "VE.DIRECT 3 + RS485 (4xx)  -  SC16IS752 channel A = VE.Direct 3, channel B = RS485 (SP3485)" (at 182.88 120.65 0) (effects (font (size 2.5 2.5) bold) (justify left bottom)) (uuid "a827d18f-0e1a-41c0-8ea5-601bf0141001"))
  (text "A" (at 358.14 161.29 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "6ed7e129-3735-4c31-9924-791c9e2a7b14"))
  (text "B" (at 358.14 176.53 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "56821b64-4f71-458e-b8de-ea1a36788b43"))
  (text "JP401: bridge = 120R termination (end of bus only)" (at 354.33 184.15 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "1eb1df6d-0cbf-418f-ad1d-31ebaf3abd34"))
  (text "RS485 transceiver SP3485, 3.3 V. DE and /RE driven together by RTSB. 14.7456 MHz crystal, 15 pF." (at 182.88 227.33 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "17fa523d-b186-4c53-87e4-83109cfaf5ab"))
  (text "VE.CAN (5xx)  -  SPI CAN controller MCP2515 + transceiver SN65HVD230" (at 22.86 242.57 0) (effects (font (size 2.5 2.5) bold) (justify left bottom)) (uuid "c2543a2d-b465-4b4a-b984-6866b66e1ce6"))
  (text "CANH" (at 168.91 266.7 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "22f4ad87-7bb8-46cf-80cd-80dc5cb9bc5a"))
  (text "CANL" (at 168.91 281.94 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "47e942c4-58d1-4b19-b2fa-438127010eef"))
  (text "JP501: bridge = 120R termination (end of bus only)" (at 165.1 289.56 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "22adba71-f226-437e-bc54-0f33c8e353fe"))
  (text "Rs = 10k to GND: slope control. 8 MHz crystal, 22 pF load caps." (at 22.86 321.31 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "ce18f8ce-ae56-416f-adf2-6fd487db9891"))
  (text "OUTPUTS (6xx)  -  ULN2003 low-side drivers OUT1-4, buzzer, fan" (at 233.68 242.57 0) (effects (font (size 2.5 2.5) bold) (justify left bottom)) (uuid "6b061610-74a6-4029-a93e-01f5b0b39321"))
  (text "IN1-IN4 high = output low. COM to +5V clamps coils. IN5-IN7 not connected (X): fan Q601 (GPIO23) and buzzer Q602 (GPIO24) are driven directly. O5-O7 unused." (at 233.68 321.31 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "baf6b328-a96f-4846-b885-8ee912305a24"))
  (text "INPUTS IN1-4 (7xx)  -  opto-isolated 5-30 V, TLP290-4" (at 398.78 242.57 0) (effects (font (size 2.5 2.5) bold) (justify left bottom)) (uuid "9555742c-6534-40ec-a54e-0181f481b3ad"))
  (text "Apply 5-30 V DC between INx and IN COM (either polarity). Output low = input active." (at 398.78 321.31 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "ff91b57d-75eb-49c5-826c-a2e943ddd35c"))
  (text "Victron Pi HAT v41.0 - one dashed box per function block. Signals between blocks join by net label name; power by power symbols. X = unused pin." (at 20.32 20.32 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid "87269f77-fabc-4496-b1fb-017d884b9e17"))
