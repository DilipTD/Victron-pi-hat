 {
  "id": "bf1d43b141cd40a0",
  "type": "function",
  "z": "882528e063304390",
  "name": "HAT analog -> global.hat",
  "x": 520,
  "y": 200,
  "wires": [
   [
    "21d32c758fa44b03"
   ]
  ],
  "func": "const NAMES = {CpuMHz:'CPU speed MHz', CpuLoadPct:'CPU load %', CpuTempC:'CPU temperature C', RamPct:'RAM used %', RamUsedMB:'RAM used MB', DataPct:'/data used %', Uptime:'Uptime', PiVolt:'Pi power / throttling', Venus:'Venus OS version'};\nconst key = msg.topic.split('/').pop();\nlet v = msg.payload; if (v && typeof v === 'object') v = v.value;\nconst hat = global.get('hat') || {}; hat[key] = v; global.set('hat', hat);\nmsg.topic = key; msg.label = NAMES[key] || key; msg.payload = v;\nreturn msg;",
  "outputs": 1,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": []
 },
