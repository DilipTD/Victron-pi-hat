   ]
  ],
  "func": "let v = msg.payload; if (v && typeof v === 'object') v = v.value;\nconst k = {State: 'FAN', Mode: 'FAN_MODE'}[msg.topic.split('/').pop()];\nif (!k) return null;   // /Fan/Present, /Fan/Temperature, ... not needed here\nconst hat = global.get('hat') || {}; hat[k] = v; global.set('hat', hat);\nmsg.topic = k; msg.payload = v;\nreturn msg;",
