 {
  "id": "556734627d03496b",
  "type": "function",
  "z": "882528e063304390",
  "name": "set OUTx / FAN / BUZZER",
  "x": 760,
  "y": 560,
  "wires": [
   [
    "2592354052b5462c"
   ]
  ],
  "func": "// msg.topic = 'OUT1'..'OUT4' or 'BUZZER', msg.payload = 1/0 (true/false)\n// msg.topic = 'FAN' (OUT5, J603, board v25.0): msg.payload = 'off'/0, 'on'/1, 'auto'/2\nconst id = flow.get('portal'); if (!id) { node.warn('portal id not known yet'); return null; }\nconst p = msg.payload;\nif (msg.topic === 'FAN') {\n  const m = {off: 0, on: 1, auto: 2}[String(p).toLowerCase()] ?? (p === true ? 1 : p === false ? 0 : Number(p));\n  if (![0, 1, 2].includes(m)) { node.warn('FAN payload must be off/on/auto or 0/1/2'); return null; }\n  return {topic: 'W/' + id + '/vichat/0/Fan/Mode', payload: JSON.stringify({value: m})};\n}\nconst v = (p === true || p === 1 || p === '1' || p === 'on') ? 1 : 0;\nlet path;\nif (/^OUT[1-4]$/.test(msg.topic)) path = 'vichat/0/Out/' + (parseInt(msg.topic.slice(3)) - 1) + '/State';\nelse if (msg.topic === 'BUZZER') path = 'vichat/0/Buzzer/Test';\nelse { node.warn('topic must be OUT1..OUT4, FAN or BUZZER'); return null; }\nreturn {topic: 'W/' + id + '/' + path, payload: JSON.stringify({value: v})};",
  "outputs": 1,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": []
 },
