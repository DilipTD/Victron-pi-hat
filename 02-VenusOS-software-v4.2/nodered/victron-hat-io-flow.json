 {
  "id": "c272806fd7e949a2",
  "type": "function",
  "z": "882528e063304390",
  "name": "keepalive",
  "x": 420,
  "y": 110,
  "wires": [
   [
    "2592354052b5462c"
   ]
  ],
  "func": "// Venus flashmq: the first keepalive asks for a full republish of all N/ topics,\n// later ones only keep the subscription alive (no flood every 30 s).\nconst id = flow.get('portal');\nif (!id) return null;\nconst first = !flow.get('ka_sent'); flow.set('ka_sent', true);\nreturn {topic: 'R/' + id + '/keepalive', payload: first ? '' : JSON.stringify({'keepalive-options': ['suppress-republish']})};",
  "outputs": 1,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": []
 },
